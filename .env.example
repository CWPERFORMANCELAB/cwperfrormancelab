# ---------------------------------------------------------------------------
# CW Performance Lab — environment variables
# Copy to .env.local for development. Everything is optional locally: the app
# falls back to an embedded database, a mock payment provider and console
# logging for email/SMS. All keys are REQUIRED for production.
# ---------------------------------------------------------------------------

# Public URL (no trailing slash). Used in emails, .ics files, Stripe redirects and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase Postgres, London/EU region) -------------------------
# Leave unset locally to use PGlite in .data/pglite. Use the *pooled* Supabase connection string in production.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# Direct (non-pooled, port 5432) connection used only by `npm run db:migrate`.
# MIGRATION_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Connections per serverless instance (1–3, default 2).
# DB_POOL_MAX=2
# Migrations run automatically only locally. In production/preview run `npm run db:migrate` as a deploy step.
# AUTO_MIGRATE=false

# --- Security ----------------------------------------------------------------
# 32 random bytes, base64:   openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Any long random string:     openssl rand -hex 32
SESSION_SECRET=
# Secret shared with Vercel Cron / external scheduler to call /api/cron/*
CRON_SECRET=

# --- Admin bootstrap (first run only; change the password in the dashboard) --
ADMIN_EMAIL=christophwilliams14@gmail.com
ADMIN_NAME=Christopher Williams
ADMIN_PASSWORD=change-me-now

# --- Stripe (test keys locally; live keys at go-live) -----------------------
# Leave unset to use the built-in mock checkout.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Email (Resend) -----------------------------------------------------------
# RESEND_API_KEY=re_...
# EMAIL_FROM="CW Performance Lab <bookings@cwperformancelab.co.uk>"

# --- SMS (Twilio) -------------------------------------------------------------
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+44...

# --- Google Calendar sync (optional) -----------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Bot protection (optional, Cloudflare Turnstile) -------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Analytics (optional) -----------------------------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
