{
  "name": "cw-performance-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/prebuild.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "apply:client-details": "tsx scripts/apply-client-details.ts",
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "seed:demo-data": "tsx scripts/seed-demo.ts",
    "clear:demo-data": "tsx scripts/clear-demo-data.ts",
    "import:vouchers": "tsx scripts/import-vouchers.ts",
    "cron": "tsx scripts/cron.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "brand:build": "tsx scripts/build-brand.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:tokens",
    "build:local": "NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-http://localhost:3000} npm run build",
    "test:e2e": "npm run build:local && vitest run -c vitest.e2e.config.mts",
    "test:e2e:only": "vitest run -c vitest.e2e.config.mts",
    "admin:reset": "tsx scripts/admin-reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@sentry/nextjs": "11.4.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^5.1.16",
    "next": "16.4.0",
    "otpauth": "^9.5.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
